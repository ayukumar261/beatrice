# OpenRouter
OPENROUTER_API_KEY=

# Braintrust
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=beatrice

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# Garage (pnpm garage:setup generates credentials and starts the local bucket)
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_BUCKET=beatrice-media
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Linq
LINQ_API_KEY=
LINQ_ALLOWED_NUMBERS=+15551234567
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_WEBHOOK_SUBSCRIPTION_ID=
LINQ_HOST=127.0.0.1
LINQ_PORT=3001
