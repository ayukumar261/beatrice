{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "OPENROUTER_API_KEY",
    "BRAINTRUST_API_KEY",
    "BRAINTRUST_PROJECT",
    "TEMPORAL_ADDRESS",
    "LINQ_API_KEY",
    "LINQ_WEBHOOK_SECRET",
    "LINQ_PHONE_NUMBER",
    "LINQ_ALLOWED_NUMBERS",
    "LINQ_WEBHOOK_SUBSCRIPTION_ID",
    "LINQ_HOST",
    "LINQ_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
