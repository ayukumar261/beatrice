{
  "name": "beatrice",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:host": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "linq:setup": "pnpm --filter gateway linq:setup",
    "garage:setup": "node scripts/garage-setup.mjs",
    "test": "turbo run test",
    "test:integration": "pnpm --filter worker test:integration"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
